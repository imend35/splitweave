# Comma-separated browser origins allowed to call the FastAPI service.
SPLITWEAVE_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SPLITWEAVE_DATABASE_URL=sqlite:///./splitweave.db

# Frontend connection settings. The real API is used unless mock mode is explicitly enabled.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_USE_MOCK_API=false
